from itertools import chain, combinations
import time

def brute_combo(file):

    f = open(file,"r")
    n = int(f.readline())
    b_t = f.readline()
    b_t=b_t.split(" ",2)
    budget = int(b_t[1])
    time = int(b_t[0])

    activities = []
    for i in range(n):
        activity = f.readline()
        
        activity = activity.split(" ",4)
        activity[3] = activity[3].replace("\n",'')
        activities.append(activity)

    f.close()

    options = powerset(activities)
    result = ''
    max_happiness = 0
    max_budget = 0
    max_time = 0
    

    for i in range(len(options)):
        h = False
        b = False
        t = False
        total_h = 0
        total_b = 0
        total_t = 0
        for j in range(len(options[i])):
            total_h += int(options[i][j][3])
            total_b += int(options[i][j][2])
            total_t += int(options[i][j][1])
        if total_h > max_happiness:
            h = True
        if total_b <= budget:
            b = True
        if total_t <= time:
            t = True
        if h and t and b:
            result = options[i]
            max_happiness = total_h
            max_budget = total_b
            max_time = total_t

    return result, max_happiness, max_budget, max_time, budget,time

def powerset(array):
    s = list(array)
    return list(chain.from_iterable(combinations(s, r) for r in range(1,len(s)+1)))


def final_output(file):
    start = time.time()
    brute_force = brute_combo(file)
    end = time.time()
    speed = end - start

    print('======================================== \nEVENT PLANNER - RESULTS \n========================================\n')
    print(f"Input File: {file}")
    print(f"Available Time: {brute_force[5]}")
    print(f"Available Budget: {brute_force[4]}\n")

    print("--- BRUTE FORCE ALGORITHM ---")
    print("Selected Activities:")
    for i in range(len(brute_force[0])):
        print(f" - {brute_force[0][i][0]} ({brute_force[0][i][1]} hours, £{brute_force[0][i][2]}, enjoyment {brute_force[0][i][3]})")
    print('')
    print(f"Total Enjoyment: {brute_force[1]}")
    print(f"Total Time Used: {brute_force[3]} hours")
    print(f"Total Cost: £{brute_force[2]}\n")
    print(f"Execution time: {speed:.4f} seconds")


